#version 450

layout(set=0, binding=0) readonly buffer in0 { float a[]; };
layout(set=1, binding=0)          buffer in1 { float b[]; };
layout(set=2, binding=0) readonly buffer in2 { uint indir[]; };

void main() {
  uint id = indir[0] - 1;
  float x = 0;
  for (int i = 0; i < 768; i++) {
    x += a[768 * id + i];
  }
  b[id] = x;
}

